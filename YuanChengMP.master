    <meta name="keywords" content="Logistic Responsive web template, Bootstrap Web Templates, Flat Web Templates, Android Compatible web template, 
Smartphone Compatible web template, free webdesigns for Nokia, Samsung, LG, SonyEricsson, Motorola web design" />

    <script>
        addEventListener("load", function () {
            setTimeout(hideURLbar, 0);
        }, false);

        function hideURLbar() {
            window.scrollTo(0, 1);
        }
    </script>

    <!-- css files -->
    <link href="css/bootstrap.css" rel='stylesheet' type='text/css' />
    <!-- bootstrap css -->
    <link href="css/style.css" rel='stylesheet' type='text/css' />
    <!-- custom css -->
    <link href="css/font-awesome.min.css" rel="stylesheet">
    <!-- fontawesome css -->
    <!-- //css files -->

    <!-- google fonts -->
    <link href="//fonts.googleapis.com/css?family=Poppins:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i&amp;subset=devanagari,latin-ext" rel="stylesheet">

    <!-- //google fonts -->

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- //header -->
        <header>
            <div class="container">

                <!-- nav -->
                <nav class="pt-2">
                    <div id="logo">
                        <img style="float: left" src="images/YUAN.png" />
                        <a href="index.html" style="font-size: 18px">
                            <h1 style="color: white">元誠傳動實業有限公司</h1>
                            <br />
                            Yuan Cheng Transmission Enterprise Co. Ltd.
                        </a>
                    </div>
                    <label for="drop" class="toggle">選單</label>
                    <input type="checkbox" id="drop" />
                    <ul class="menu mt-md-2 ml-auto">
                        <li class="mr-lg-4 mr-2"><a href="index.html">首頁</a></li>
                        <li class="mr-lg-4 mr-2"><a href="about.html">公司簡介</a></li>
                        <li class="mr-lg-4 mr-2"><a href="services.html">產品介紹</a></li>
                        <li class="mr-lg-3 mr-2 p-0">
                            <!-- First Tier Drop Down -->
                            <label for="drop-2" class="toggle">客服諮詢 <span class="fa fa-angle-down" aria-hidden="true"></span></label>
                            <a href="#">客服諮詢 <span class="fa fa-angle-down" aria-hidden="true"></span></a>
                            <input type="checkbox" id="drop-2" />
                            <ul class="inner-dropdown">
                                <li><a href="gallery.html">管理者登入</a></li>
                                <li><a href="error.html">新增詢價單</a></li>
                            </ul>
                        </li>
                        <li class="mr-lg-4 mr-2"><a href="contact.html">周邊道路</a></li>
                        <li class=""><a href="#subscribe">聯絡我們</a></li>
                    </ul>
                </nav>
                <!-- //nav -->
            </div>
        </header>
        <!-- //header -->
        <!-- inner banner -->
        <div class="inner-banner" id="home">
            <div class="container">
            </div>
        </div>
        <!-- inner banner -->
        <!-- contact -->
        <section class="contact py-5 my-lg-5">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">

            </asp:ContentPlaceHolder>
        </section>
        <!-- //contact -->
        <!-- footer-top -->
        <section class="footer-top py-5" id="subscribe">
            <div class="container">
                <div class="copyright">
                    <p style="font-size: 25px; color: #e9ecef;">
                        <img src="images/YUAN.png" />元誠傳動實業有限公司<br />
                    </p>
                    <p style="color: #e9ecef;">
                        <span class="fa fa-phone" aria-hidden="true"></span>03-536-5262/03-536-5292 <span class="fa fa-print" aria-hidden="true"></span>(FAX)03-536-5291<br />
                        <span class="fa  fa-map-marker">30058 新竹市北區中寮里13鄰中福路65巷2號</span>
                    </p>
                    <p style="color: #e9ecef;">
                        © 2019 Logistic. All Rights Reserved | Design by <a href="http://w3layouts.com/">W3layouts</a>
                    </p>
